{
  "name": "smpp-ts",
  "version": "1.1.0",
  "description": "SMPP v3.4/v5.0 client and server in TypeScript: secure by default, production-ready, zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "smpp-ts": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "keywords": [
    "smpp",
    "sms",
    "smsc",
    "esme",
    "gsm",
    "typescript",
    "opentelemetry",
    "smpp-client",
    "smpp-server",
    "smpp34",
    "smpp5",
    "sms-gateway",
    "delivery-receipt",
    "gsm7",
    "ucs2"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime": "npm run build && node test/runtime/smoke.mjs",
    "test:interop": "vitest run --config vitest.interop.config.ts",
    "test:jasmin": "JASMIN=1 vitest run --config vitest.interop.config.ts test/interop/jasmin",
    "test:kannel": "KANNEL=1 vitest run --config vitest.interop.config.ts test/interop/kannel",
    "coverage": "vitest run --coverage",
    "fuzz": "FUZZ_RUNS=1000000 vitest run test/fuzz --testTimeout=3600000",
    "soak": "SOAK=1 vitest run test/soak",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "bench": "npm run build && node bench/run.mjs",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "fixtures:build": "node test/fixtures/build.mjs",
    "version-packages": "changeset version && node scripts/sync-jsr-version.mjs",
    "jsr:check": "npx --yes jsr publish --dry-run --allow-slow-types --allow-dirty",
    "jsr:publish": "npx --yes jsr publish --allow-slow-types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AristideDongo/smpp-ts.git"
  },
  "homepage": "https://github.com/AristideDongo/smpp-ts#readme",
  "bugs": {
    "url": "https://github.com/AristideDongo/smpp-ts/issues"
  }
}
