{
  "name": "smpp-ts",
  "version": "0.2.0",
  "description": "SMPP v3.4/v5.0 client and server in TypeScript: secure by default, production-ready, zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "keywords": [
    "smpp",
    "sms",
    "smsc",
    "esme",
    "gsm",
    "typescript",
    "opentelemetry"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime": "npm run build && node test/runtime/smoke.mjs",
    "test:interop": "vitest run --config vitest.interop.config.ts",
    "coverage": "vitest run --coverage",
    "fuzz": "FUZZ_RUNS=1000000 vitest run test/fuzz --testTimeout=3600000",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AristideDongo/smpp-ts.git"
  },
  "homepage": "https://github.com/AristideDongo/smpp-ts#readme",
  "bugs": {
    "url": "https://github.com/AristideDongo/smpp-ts/issues"
  }
}
