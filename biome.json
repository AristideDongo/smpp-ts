{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": { "ignore": ["dist", "coverage", "node_modules", "package.json", "package-lock.json"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "useNumberNamespace": "off", "noParameterAssign": "off" },
      "complexity": { "noBannedTypes": "off" },
      "suspicious": { "noExplicitAny": "warn", "noControlCharactersInRegex": "off" }
    }
  }
}
